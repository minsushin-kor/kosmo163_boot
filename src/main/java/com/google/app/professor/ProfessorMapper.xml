<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
  
<mapper namespace="com.google.app.professor.ProfessorMapper">
	<select id="getCount" resultType="Long">
		SELECT COUNT(PROFESSOR_NO) FROM TB_PROFESSOR
	</select>

	<select id="list" resultType="ProfessorDTO" parameterType="Pager">
		<![CDATA[
		SELECT PROFESSOR_NO, PROFESSOR_NAME, DEPARTMENT_NO FROM	
		(
			SELECT ROWNUM R, T.* FROM
			(
				SELECT * FROM TB_PROFESSOR
				ORDER BY PROFESSOR_NO ASC
			) T
		)
		WHERE R BETWEEN #{first} AND #{last}
		]]>
	</select>
	
	<select id="detail" resultType="ProfessorDTO" parameterType="ProfessorDTO">
		SELECT * FROM TB_PROFESSOR
		WHERE PROFESSOR_NO=#{professorNo}
	</select>
	
	<insert id="create" parameterType="ProfessorDTO">
		INSERT INTO TB_PROFESSOR
		VALUES (#{professorNo}, #{professorName}, #{professorSsn}, #{professorAddress}, #{departmentNo})
	</insert>
	
	<update id="update" parameterType="ProfessorDTO">
		UPDATE TB_PROFESSOR
		SET 
		PROFESSOR_NAME=#{professorName},
		PROFESSOR_SSN=#{professorSsn},
		PROFESSOR_ADDRESS=#{professorAddress}
		WHERE
		PROFESSOR_NO=#{professorNo}
	</update>
	
	<delete id="delete" parameterType="ProfessorDTO">
		DELETE TB_PROFESSOR
		WHERE
		PROFESSOR_NO=#{professorNo}
	</delete>
	
</mapper>
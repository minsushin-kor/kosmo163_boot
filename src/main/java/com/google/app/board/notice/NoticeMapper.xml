<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.google.app.board.notice.NoticeMapper">
	<!-- File 시작 -->
	<insert id="createFile" parameterType="NoticeFileDTO">
		
		INSERT INTO TB_NOTICEFILE 
		VALUES (BOARD_SEQ.NEXTVAL, #{fileName}, #{oriName}, #{boardNum})
	</insert>
	<!-- File 끝 -->
  	
  	<sql id="search">
  		WHERE 
		<choose>
			<when test="kind=='v2'">BOARD_CONTENTS</when>
			<when test="kind=='v3'">BOARD_WRITER</when>
			<otherwise>BOARD_TITLE</otherwise>
		</choose>
  		
  		LIKE '%'||#{search}||'%'
  	</sql>
  
  	<resultMap type="NoticeDTO" id="detailResult">
  		<!-- ID : Primary Key 입력 -->
  		<!-- column : pk의 컬럼명 property : 위에 선언한 DTO의 setter이름 -->
  		<id column="BOARD_NUM" property="boardNum"/>
  		
  		<!-- 그외 나머지 -->
  		<result column="BOARD_TITLE" property="boardTitle"/>
  		<result column="BOARD_WRITER" property="boardWriter"/>
  		<result column="BOARD_CONTENTS" property="boardContents"/>
  		<result column="BOARD_DATE" property="boardDate"/>
  		<result column="BOARD_HIT" property="boardHit"/>
  		
  		<!-- 1:N의 관계 - collection태그 -->
  		<collection property="list" javaType="java.util.List" ofType="NoticeFileDTO">
  			<id column="FILE_NUM" property="fileNum"/>
  			<result column="FILE_NAME" property="fileName"/>
  			<result column="ORI_NAME" property="oriName"/>  			
  		</collection>
  		
  		<!-- 1:1의 관계 : association사용(collection과 문법은 동일하여 참고하여 사용 가능) -->
  		<!-- 복합적인 관계일 경우 1:1을 먼저 작성하고 1:N을 작성해야 오류가 발생하지 않음 -->
  	
  	</resultMap>
  	
  	<select id="detail" parameterType="NoticeDTO" resultMap="detailResult">
  		SELECT * FROM TB_NOTICE N
		LEFT OUTER JOIN TB_NOTICEFILE NF 
		ON N.BOARD_NUM = NF.BOARD_NUM 
		WHERE N.BOARD_NUM = #{boardNum}
  	</select>
  	  	
  	<select id="getCount" resultType="Long" parameterType="Pager">
  		SELECT COUNT(BOARD_NUM) FROM TB_NOTICE
  		<include refid="search"></include>
  	</select>
  
  	<!-- list -->
  	<select id="list" resultType="NoticeDTO" parameterType="Pager">
  		
			SELECT * FROM
				(
					SELECT ROWNUM R, T.* FROM
					(
						SELECT * FROM TB_NOTICE
						<include refid="search"></include>
						ORDER BY BOARD_NUM DESC
					) T
				)
			WHERE R BETWEEN #{first} AND #{last}
		
  	</select>

    <!-- create -->	
    <insert id="create" parameterType="NoticeDTO">
    	<selectKey order="BEFORE" resultType="Long" keyProperty="boardNum">
			SELECT BOARD_SEQ.NEXTVAL FROM DUAL
		</selectKey>
    	INSERT INTO TB_NOTICE 
    	VALUES (#{boardNum}, #{boardTitle}, #{boardContents}, #{boardWriter}, sysdate, 0)
    </insert>

</mapper>